digraph G {
graph [rankdir=LR, bgcolor="white", pad=0.15, nodesep=0.27, ranksep=0.38];
node [shape=box, style="rounded,filled", fillcolor="#eef4fa", color="#617b91", fontname="DejaVu Sans", fontsize=13, margin="0.13,0.08"];
